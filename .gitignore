# Maven build output
target/

# Binary dependencies are provided locally and are not published
*.jar
*.lastUpdated

# IntelliJ IDEA project-local files
.idea/
*.iml
*.ipr
*.iws

# Eclipse project-local files
.classpath
.project
.settings/

# Build and runtime logs
*.log
hs_err_pid*
replay_pid*

# Python cache generated by maintenance scripts
__pycache__/
*.py[cod]

# Maven helper/plugin output
.flattened-pom.xml
dependency-reduced-pom.xml
pom.xml.versionsBackup
.mvn/timing.properties

# Local environment and operating-system files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
Desktop.ini

# Public resources and placeholders for private default configurations
/plugin/src/main/resources/*
!/plugin/src/main/resources/config.yml
!/plugin/src/main/resources/plugin.yml
!/plugin/src/main/resources/paper-plugin.yml
!/plugin/src/main/resources/languages/
!/plugin/src/main/resources/menus/
!/plugin/src/main/resources/vanilla_enchantments/
!/plugin/src/main/resources/attributes/
!/plugin/src/main/resources/skills/
!/plugin/src/main/resources/enchantments/
/plugin/src/main/resources/attributes/*
/plugin/src/main/resources/skills/*
/plugin/src/main/resources/enchantments/*
!/plugin/src/main/resources/attributes/.gitkeep
!/plugin/src/main/resources/skills/.gitkeep
!/plugin/src/main/resources/enchantments/.gitkeep

# Local development tools and private configuration migration data
/.buildtools/
/.workbuddy/

# Publish only source code and necessary build files
**/src/test/
/docs/
/cn_docs/
/MODIFICATION_REPORT.md
/tools/
